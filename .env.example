# Discord (obrigatório na Vercel)
DISCORD_PUBLIC_KEY=

# Discord (necessários apenas para registrar os comandos localmente)
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# URL pública estável da implantação. Se ficar vazia, usa a URL da requisição.
PUBLIC_BASE_URL=

# Dados fixos do servidor
SERVER_NAME=Clube das Winx | Project Zomboid
SERVER_HOST=169.155.127.74
SERVER_PORT=9045
SERVER_DDNS=clubedaswinx.modded.fun:9045
SERVER_MAX_PLAYERS=32

# Consulta de status: auto tenta A2S e depois a API externa.
# Valores: auto, a2s, external
STATUS_PROVIDER=auto
A2S_HOST=169.155.127.74
A2S_QUERY_PORT=9045
A2S_TIMEOUT_MS=1800
STATUS_CACHE_TTL_MS=15000

# Fallback HTTP opcional. Use {host} e {port} na URL se necessário.
# Exemplo: https://status.exemplo.com/query?host={host}&port={port}
STATUS_API_URL=
STATUS_API_TOKEN=
STATUS_API_TIMEOUT_MS=3000

# Ranking público (Supabase). Não usar chave de serviço nestes campos.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Manter vazio até aplicar/validar 003 em ambiente autorizado. Então: winx-v1.
# Não é configurado pela prévia; nenhum serviço externo foi alterado.
COMPETITION_RULES_VERSION=
# Somente após validar 004/005, catálogo de 100 e emissor confiável de identidade.
LIFE_CONTRACT_VERSION=
# Verificação privada opcional por check:readiness; não enviar ao navegador.
EXPECTED_SUPABASE_PROJECT_REF=

# Admin: identificar explicitamente o administrador no backend. Não preencher na prévia.
ADMIN_EMAIL=
# Escrita administrativa requer revisão de segregação e autorização antes de configurar.
# SUPABASE_SERVICE_ROLE_KEY=
# Associação manual conferida: UUID do personagem (preferido) ou nome legado -> URL Steam.
# Não é descoberta automática. Sem associação, usa monograma individual do registro.
STEAM_PROFILE_MAP_JSON={}

# Somente após aplicar/verificar 008_season_schedule.sql e o prazo da temporada.
SEASON_SCHEDULE_CONTRACT_VERSION=
